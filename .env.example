# Meilisearch keys
MEILI_MASTER_KEY=aMasterKey
MEILI_SEARCH_API_KEY=aMasterKey
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
# Internal Docker network settings for the backend container
DB_HOST=postgres
DB_PORT=5432
# Alerts workers use DATABASE_URL when set; otherwise they assemble the same
# Postgres URL from the DB_* values above. Do not put a local SQLite URL here.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0


KITE_API_KEY=your api key
KITE_API_SECRET=your secret key
KITE_USER_ID=****
KITE_PASSWORD=*****
KITE_TOTP_KEY=******

# Notifications (leave empty to disable)
SCHEDULER_NTFY_URL=
KITE_ALERTS_NTFY_URL=
MEILI_URL=http://meilisearch:7700
VITE_API_BASE_URL=http://localhost:18777

# App environment and auth (separate from broker auth)
APP_ENV=development
APP_ALLOW_INSECURE_DEV_AUTH=false
APP_JWT_SECRET=change-me-to-a-long-random-secret
APP_JWT_ACCESS_MINUTES=15
APP_JWT_REFRESH_DAYS=14
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
# Preferred over APP_ADMIN_PASSWORD in production
# Format: pbkdf2_sha256$iterations$salt$hex_digest
APP_ADMIN_PASSWORD_HASH=
# Safer in Docker Compose because it avoids '$' interpolation. Base64 of APP_ADMIN_PASSWORD_HASH.
APP_ADMIN_PASSWORD_HASH_B64=
# Alternative: mount a secret file and point to it.
APP_ADMIN_PASSWORD_HASH_FILE=

# CORS origins and frontend dev origins
APP_ALLOWED_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
# Add your deployment hostname here when opening the dev app through a domain,
# reverse proxy, LAN hostname, or tunnel.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Host-exposed service ports (for local tools on your machine)
# Frontend:    http://localhost:13000
# Backend:     http://localhost:18777
# Market WS:   http://localhost:18780
# PostgreSQL:  localhost:15432
# Redis:       localhost:16379
# Meilisearch: http://localhost:17700
# Unified Go market runtime
MARKET_RUNTIME_ENABLED=false
MARKET_RUNTIME_HTTP_URL=http://localhost:18780

# Alerts evaluation/delivery worker. Active workflow symbols resolve through
# the shared PostgreSQL instrument catalog. This JSON map is only a
# compatibility fallback for the bootstrap window while the catalog is
# uninitialized (or with ALERTS_INSTRUMENT_TOKEN_FALLBACK=always below).
ALERTS_INSTRUMENT_TOKENS={}
# Compatibility fallback policy: unset = env map applies ONLY while the
# catalog is uninitialized; "always" = legacy behavior (also on temporary
# catalog unavailability and initialized-catalog not-found, loudly logged).
# Retired/expired/ambiguous instruments are never resolved from this map.
ALERTS_INSTRUMENT_TOKEN_FALLBACK=
ALERTS_REFRESH_INTERVAL_S=10
ALERTS_HEALTH_INTERVAL_S=30
ALERTS_DELIVERY_ENABLED=1
# Phase 2: universe membership resolution cadence (worker-side, seconds) and
# per-(workflow, alert) emissions budget per 60 s window (E-25 storm guard).
ALERTS_UNIVERSE_RESOLVE_INTERVAL_S=300
ALERTS_DELIVERY_BUDGET_PER_WINDOW=60
# Optional path when running the worker outside Compose.
ALERTS_HEALTH_FILE=

# Notification channels reference secret environment variables by name.
# Store actual values in the deployment secret manager, never in this file.
# Example channel rows use secret_env=TELEGRAM_BOT_TOKEN or NTFY_PRIMARY_URL.
TELEGRAM_BOT_TOKEN=
NTFY_PRIMARY_URL=
# MEILI_API_KEY is deprecated in favor of MEILI_SEARCH_API_KEY
# MEILI_API_KEY=aMasterKey

# Optional LAN Streamable HTTP MCP service (disabled by default).
# Set COMPOSE_PROFILES=mcp to include it in docker compose up -d.
# If you already use profiles, append mcp to the comma-separated list.
COMPOSE_PROFILES=
KITE_MCP_PROFILE=read
KITE_MCP_ALLOW_DATA_REFRESH=false
KITE_MCP_HOST_PORT=18788
KITE_MCP_BIND_ADDRESS=0.0.0.0
# Existing worker credential: backend authorization, never given to LAN clients.
KITE_MCP_WORKER_TOKEN=
# Separate random client bearer secret, minimum 32 characters (required).
# Generate locally: openssl rand -hex 32
KITE_MCP_HTTP_TOKEN=
# Required: server LAN IP/hostname, NOT the client devices' IPs or a URL.
# Example: 192.168.1.100,kite.local
KITE_MCP_ALLOWED_HOSTS=
# Optional exact browser origins, comma-separated; native MCP clients need none.
KITE_MCP_ALLOWED_ORIGINS=
