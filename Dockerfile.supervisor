# Supervisor image for the hosted-strategy runner.
#
# The supervisor process runs as root inside the container only so it can install
# per-child rlimits, drop supplementary groups and chown the child scratch dir.
# The *child* runs as an unprivileged, distinct OS identity (uid/gid 10002) and
# is the boundary that matters. This is a trusted single-operator setup — it is
# NOT a claim of complete security isolation.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Dependencies are the hosted child's SDK runtime, installed at BUILD time.
# The supervisor itself is standard-library only (urllib/subprocess), and it
# holds NO database or broker credentials, so the platform's backend
# requirements (psycopg2, SQLAlchemy, FastAPI, uvicorn, kiteconnect, ...) are
# NOT installed here: they are unnecessary, they previously broke the build
# (psycopg2 has no binary wheel on slim images), and a DB driver inside the
# runner image would work against the credential-free design.
#
# The single documented runner profile is "hosted-python-dataframe-indicators"
# (backend/strategies/readiness.py): the SDK's `dataframe` and `indicators`
# extras (pandas, numpy, numba) are installed from wheels here, so a strategy
# can `import pandas`/`numpy`/`numba` and use the client-side indicator library.
# There is deliberately NO runtime pip installation path: a strategy cannot ask
# for a package at launch, and this image is the whole answer to "what can my
# strategy import?". Server-side indicators (`POST /worker/indicators`) run in
# the backend image, so a strategy that needs no local numerical stack does not
# need these packages at all.
RUN pip install --no-cache-dir "requests>=2" "httpx>=0.27" "websockets>=12"

# Dedicated unprivileged identity for hosted children.
RUN groupadd -g 10002 strategy-child \
    && useradd -u 10002 -g 10002 -M -s /usr/sbin/nologin strategy-child

WORKDIR /app

# The hosted child imports this SDK from its OWN working directory (the child
# never runs with /app as cwd), so it must be installed rather than merely
# copied into /app. The platform's repo-level `fundamentals/` package is not
# part of this image (the SDK ships its own module).
COPY sdk/python/pyproject.toml sdk/python/README.md /tmp/sdk/
COPY sdk/python/kite_algo_worker/ /tmp/sdk/kite_algo_worker/
# `[indicators]` pulls the `dataframe` + `indicators` extras the profile
# documents (pandas, numpy, numba).
RUN pip install --no-cache-dir "/tmp/sdk[indicators]" && rm -rf /tmp/sdk

COPY backend/ /app/backend/

# No database credentials are provided to this image's default command.
CMD ["python", "-m", "backend.strategies.supervisor"]
